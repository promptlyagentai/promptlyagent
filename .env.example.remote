# ================================================================================================
# PromptlyAgent - Custom Domain Configuration Template
# ================================================================================================
# Copy relevant sections to your .env file
# Replace app.example.com with your actual domain
#
# Example: Accessing Sail via https://app.example.com with reverse proxy
#
# SIMPLIFIED PATTERN:
#   1. Set APP_HOST and APP_PROTOCOL
#   2. Derive all other values from these
#   3. Keep values consistent across APP_URL, REVERB_*, and VITE_REVERB_*
# ================================================================================================

APP_NAME=PromptlyAgent
APP_ENV=local
APP_DEBUG=true

# ================================================================================================
# Base Configuration
# ================================================================================================
# Set these first, then derive all other URL values

APP_HOST=app.example.com
APP_PROTOCOL=https

# Derived value: ${APP_PROTOCOL}://${APP_HOST}
APP_URL=https://app.example.com

# Copy all other standard settings from .env.example
# (APP_KEY, DB_*, CACHE_*, QUEUE_*, AI_*, etc.)
# ...

# ================================================================================================
# WebSocket Configuration (Reverb)
# ================================================================================================
# IMPORTANT: All values must match the APP_HOST and APP_PROTOCOL pattern

# Internal container-to-container (unchanged)
REVERB_BROADCAST_HOST=reverb
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http

# External browser connections (derived from APP_HOST and APP_PROTOCOL)
REVERB_HOST=app.example.com
REVERB_PORT=443                 # 443 for https, 80 for http
REVERB_SCHEME=https             # Must match APP_PROTOCOL

REVERB_APP_ID=promptlyagent
REVERB_APP_KEY=reverb-key
REVERB_APP_SECRET=reverb-secret

# ================================================================================================
# Frontend Configuration (Vite + Laravel Echo)
# ================================================================================================
# These are embedded in JavaScript at build time
# MUST match REVERB_* values above

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_APP_ID="${REVERB_APP_ID}"
VITE_REVERB_HOST=app.example.com    # Must match REVERB_HOST
VITE_REVERB_PORT=443                # Must match REVERB_PORT
VITE_REVERB_SCHEME=https            # Must match REVERB_SCHEME

# ================================================================================================
# Vite HMR (Hot Module Replacement)
# ================================================================================================
# VITE_HMR_HOST and VITE_DEV_SERVER_URL are automatically passed through to the container
# via docker-compose.yml from REVERB_HOST and REVERB_SCHEME settings above.
# No additional configuration needed here.
# Only active when running: ./vendor/bin/sail npm run dev

# ================================================================================================
# Reverse Proxy Setup (Ultra-Simplified!)
# ================================================================================================
# Sail's internal nginx (docker/nginx/laravel.conf) already handles ALL routing:
#   - PHP-FPM
#   - Reverb WebSocket (/ws/* endpoints)
#   - Vite HMR (/@vite/* endpoints when running npm run dev)
#   - Static assets
#
# Your external reverse proxy ONLY needs to forward port 80. That's it!
#
# Replace <sail-host> with:
#   - localhost (if proxy runs on same host)
#   - host.docker.internal (if proxy is in Docker on same host)
#   - actual IP/hostname (if on different machine)
#
# ================================================================================================
#
# CADDY (Caddyfile) - Simplest, automatic HTTPS:
# -----------------------------------------------
# app.example.com {
#     reverse_proxy <sail-host>:80
# }
#
# ================================================================================================
#
# NGINX - Most common:
# --------------------
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     '' close;
# }
#
# server {
#     listen 443 ssl http2;
#     server_name app.example.com;
#
#     ssl_certificate /path/to/cert.pem;
#     ssl_certificate_key /path/to/key.pem;
#
#     location / {
#         proxy_pass http://<sail-host>:80;
#         proxy_set_header Host $host;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_set_header X-Forwarded-Host $host;
#         proxy_set_header X-Forwarded-Port $server_port;
#
#         # WebSocket support
#         proxy_http_version 1.1;
#         proxy_set_header Upgrade $http_upgrade;
#         proxy_set_header Connection $connection_upgrade;
#         proxy_buffering off;
#     }
# }
#
# ================================================================================================
#
# TRAEFIK (Docker labels):
# ------------------------
# Add to docker-compose.override.yml under laravel.test service:
#
# labels:
#   - "traefik.enable=true"
#   - "traefik.http.routers.app.rule=Host(`app.example.com`)"
#   - "traefik.http.routers.app.entrypoints=websecure"
#   - "traefik.http.routers.app.tls=true"
#   - "traefik.http.services.app.loadbalancer.server.port=80"
#
# ================================================================================================
#
# See docs/10-custom-domains.md for complete examples and troubleshooting
